# Required
TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather in Telegram

# Optional — without it, messages come from built-in templates
ANTHROPIC_API_KEY=sk-ant-...
ORACLE_MODEL=claude-haiku-4-5-20251001

# Timing (production defaults)
TZ_NAME=Asia/Kolkata
PRE_LEAD_MINUTES=15
POST_LAG_MINUTES=5
POLL_SECONDS=60
DAY_AHEAD_AT=08:30

# Demo settings: uncomment these so seeded events fire seconds apart
# PRE_LEAD_MINUTES=1
# POST_LAG_MINUTES=0
# POLL_SECONDS=15
