# Required
TELEGRAM_BOT_TOKEN=123456:ABC...        # from @BotFather in Telegram

# LLM — pick one. Without either, messages come from built-in templates.
# OpenRouter (recommended, cheap): https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-...
JOSIYAM_MODEL=deepseek/deepseek-v4-flash            # ~$0.00002 per message
JOSIYAM_FALLBACK_MODELS=deepseek/deepseek-v3.2,google/gemma-4-31b-it:free
# or Anthropic direct:
# ANTHROPIC_API_KEY=sk-ant-...
# JOSIYAM_MODEL=claude-haiku-4-5-20251001

# Timing (production defaults)
TZ_NAME=Asia/Kolkata
PRE_LEAD_MINUTES=15
POST_LAG_MINUTES=5
POLL_SECONDS=60
DAY_AHEAD_AT=08:30
EOD_AT=21:00

# Demo settings: uncomment these so seeded events fire seconds apart
# PRE_LEAD_MINUTES=1
# POST_LAG_MINUTES=0
# POLL_SECONDS=15
